# Copy to .env. Leave NEBIUS_API_KEY empty to run in offline demo mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirm the exact IDs in the Token Factory console on day 1.
MODEL_NANO=nvidia/nemotron-3-nano
MODEL_SUPER=nvidia/nemotron-3-super
MODEL_ULTRA=nvidia/nemotron-3-ultra
STUCK_DAYS=5
